<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API<29 直写公共 Download/VidHub 目录需要此权限；API≥29 走 MediaStore.Downloads 免权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- C5 下载前台服务（T10）：FOREGROUND_SERVICE 为基础权限，
         DATA_SYNC 为 API34+ startForeground(带 type) 必需；POST_NOTIFICATIONS 为 API33+ 通知可见性
         （未授权时服务照跑仅通知不可见，不阻塞下载） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TV 设备（leanback）声明：非 TV 设备也允许安装 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VidHub"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- 说明：usesCleartextTraffic=true 是必要的 —— 视频为直连播放，
             部分 CMS 源的 M3U8 地址是 http://，禁止明文流量会导致无法播放。
             搜索/详情请求目标为用户自建的 VidHub 服务端，建议使用 https。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detail.DetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.player.PlaybackActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.ServerEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.CustomSourcesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 下载任务管理页（T12 C5）：设置页内跳转，不导出 -->
        <activity
            android:name=".ui.settings.DownloadManageActivity"
            android:exported="false" />

        <!-- 下载前台服务（T10 C5）：dataSync 类型，队列空自停；不导出（仅应用内 start） -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
